# Upstox API Credentials Configuration Template
# Copy this file to .env:  cp .env.example .env
# .env is ignored by git and will NEVER be pushed to GitHub!

# 1. Daily Upstox OAuth2 Bearer Access Token:
UPSTOX_ACCESS_TOKEN=your_access_token_here

# 2. (Optional) Upstox App API Key & Secret for OAuth Code Exchange:
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/callback
